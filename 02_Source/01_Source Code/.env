# ===========================================
# Docker Compose Environment Variables
# ===========================================
# Copy this file to `.env` and adjust values as needed.

# -------------------------------------------
# PostgreSQL
# -------------------------------------------
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_DB=mydatabase
POSTGRES_PORT=5432

# -------------------------------------------
# Redis
# -------------------------------------------
REDIS_PASSWORD=redispassword
REDIS_PORT=6379

# -------------------------------------------
# Elasticsearch
# -------------------------------------------
ELASTICSEARCH_PORT=9200

# -------------------------------------------
# Keycloak
# -------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8081
KEYCLOAK_REALM=inventory-management

# -------------------------------------------
# AI Service
# -------------------------------------------
AI_SERVICE_PORT=8000

# -------------------------------------------
# RAG Service
# -------------------------------------------
RAG_SERVICE_PORT=8001
RAG_SERVICE_SHARED_SECRET=1f0f2b0f9e6f4f6bb2c4c9d8a6e3f1c7e8d5a2b9c4f7d1a3e6b8c0d2f4a6e9b

# -------------------------------------------
# Backend
# -------------------------------------------
BACKEND_PORT=3000
BYPASS_AUTH=false
KEYCLOAK_CLIENT_SECRET=backend-secret-change-in-production

# -------------------------------------------
# Frontend
# -------------------------------------------
FRONTEND_PORT=5173
VITE_BYPASS_KEYCLOAK=false
# -------------------------------------------
# Observability Stack
# -------------------------------------------
LOG_LEVEL=info
OTEL_ENABLED=true
METRICS_AUTH_TOKEN=mFZwqgKlwotYaGzf6pReERhTlfQedS/jAZFWZqoOXiGv6sxaTItOrC1MyojCMxb2
VITE_OTEL_ENABLED=true
VITE_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
VITE_ENVIRONMENT=local

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123
GRAFANA_PORT=3001

# Alertmanager SMTP (email alerts)
SMTP_SMARTHOST=smtp.gmail.com:587
SMTP_FROM=alerts@example.com
SMTP_AUTH_USERNAME=alerts@example.com
SMTP_AUTH_PASSWORD=replace-me
ALERT_EMAIL_TO=team@example.com

# OpenAI
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://ollama:11434/v1
OPENAI_MODEL=qwen2.5:1.5b
OPENAI_EMBEDDING_MODEL=nomic-embed-text
RAG_FORCE_LLM_FOR_KPI=true