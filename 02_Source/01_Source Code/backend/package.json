{
  "name": "ims-backend",
  "version": "1.0.0",
  "description": "Inventory Management System Backend",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "jest --verbose",
    "test:watch": "jest --watch",
    "test:coverage": "jest --verbose --coverage",
    "test:db-integration": "jest --runInBand src/modules/__tests__/warehouse-lifecycle-db.integration.test.ts",
    "test:api-integration": "jest --runInBand src/modules/__tests__/warehouse-lifecycle-api.test.ts"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.11.0",
    "@types/pg": "^8.16.0",
    "bwip-js": "^4.8.0",
    "dotenv": "^17.2.4",
    "express": "^4.18.2",
    "jest-util": "^30.2.0",
    "jsbarcode": "^3.12.3",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.18.0",
    "qrcode": "^1.5.4",
    "redis": "^5.11.0"
  },
  "devDependencies": {
    "@flydotio/dockerfile": "^0.7.10",
    "@jest/globals": "^29.7.0",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.4.2",
    "@types/qrcode": "^1.5.6",
    "@types/redis": "^4.0.10",
    "@types/supertest": "^7.2.0",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  }
}
