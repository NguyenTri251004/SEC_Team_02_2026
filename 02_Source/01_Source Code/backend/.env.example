# ==========================================
# Environment Configuration (Example)
# ==========================================

# Environment Type
NODE_ENV=production

# Database Provider: "local" or "remote"
# If not set, defaults to "local" in development and "remote" in production
DB_PROVIDER=remote

# ==========================================
# Option 1: Supabase Connection
# ==========================================
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# ==========================================
# Option 2: Local PostgreSQL Connection
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mydatabase
DB_USER=myuser
DB_PASSWORD=mypassword

# Server Configuration
PORT=3000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# ==========================================
# Redis Cache (tùy chọn — app vẫn chạy nếu không có Redis)
# ==========================================
REDIS_URL=redis://localhost:6379

# ==========================================
# Elasticsearch (cho full-text search)
# ==========================================
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ==========================================
# Authentication & Security
# ==========================================
# JWT Secret for development (production nên dùng Keycloak public key)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Keycloak Configuration
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=inventory-management
KEYCLOAK_PUBLIC_KEY=

# Bypass authentication in development mode (set to "true" for dev)
BYPASS_AUTH=true
