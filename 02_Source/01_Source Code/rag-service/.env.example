# Core
RAG_SERVICE_PORT=8000
RAG_BYPASS_S2S=false
RAG_SERVICE_SHARED_SECRET=1f0f2b0f9e6f4f6bb2c4c9d8a6e3f1c7e8d5a2b9c4f7d1a3e6b8c0d2f4a6e9b
RAG_S2S_MAX_SKEW_SECONDS=300

# OpenAI
# Local free default via Ollama (OpenAI-compatible)
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=qwen2.5:1.5b
OPENAI_EMBEDDING_MODEL=nomic-embed-text
RAG_FORCE_LLM_FOR_KPI=true

# Retrieval
RAG_TOP_K=6
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_EMBEDDING_DIM=256
RAG_STORAGE_PATH=./data/vector_store.json
KB_DOCS_DIR=../01_Documents
RAG_MAX_DOCUMENTS_PER_INGEST=50
RAG_MAX_CHARS_PER_DOCUMENT=100000
RAG_MAX_TOTAL_CHARS_PER_INGEST=2000000

# Inventory indexing pipeline
DATABASE_URL=postgresql://myuser:mypassword@localhost:5432/mydatabase
RAG_INDEX_NAMESPACE=ims_inventory
RAG_INDEX_VERSION=v1
RAG_SEED_ON_STARTUP=true
RAG_ENABLE_SCHEDULED_SYNC=true
RAG_SYNC_INTERVAL_SECONDS=900
RAG_INCREMENTAL_LOOKBACK_SECONDS=1800

# Optional Mongo source
RAG_MONGO_URI=
RAG_MONGO_DB=ims

# Observability
LOG_LEVEL=info
