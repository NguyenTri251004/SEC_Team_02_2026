# ===========================================
# Production Environment Variables
# ===========================================
# IMPORTANT: Copy this to .env before deploying
# Change ALL default values below!

# PostgreSQL
POSTGRES_USER=ims_admin
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=ims_production

# Redis
REDIS_PASSWORD=CHANGE_ME_redis_password_here

# Backend
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_64
FRONTEND_URL=https://your-domain.com

# Frontend
FRONTEND_PORT=80

# Keycloak (optional - remove if using BYPASS_AUTH)
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=inventory-management
KEYCLOAK_CLIENT_ID=inventory-frontend
