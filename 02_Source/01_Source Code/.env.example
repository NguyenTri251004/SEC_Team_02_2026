# ===========================================
# Docker Compose Environment Variables
# ===========================================
# Copy this file to `.env` and adjust values as needed.

# -------------------------------------------
# PostgreSQL
# -------------------------------------------
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_DB=mydatabase
POSTGRES_PORT=5432

# -------------------------------------------
# Redis
# -------------------------------------------
REDIS_PASSWORD=redispassword
REDIS_PORT=6379

# -------------------------------------------
# Elasticsearch
# -------------------------------------------
ELASTICSEARCH_PORT=9200

# -------------------------------------------
# Keycloak
# -------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8080
KEYCLOAK_REALM=inventory-management

# -------------------------------------------
# AI Service
# -------------------------------------------
AI_SERVICE_PORT=8000

# -------------------------------------------
# RAG / LLM (Local Free Defaults)
# -------------------------------------------
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://ollama:11434/v1
OPENAI_MODEL=qwen2.5:1.5b
OPENAI_EMBEDDING_MODEL=nomic-embed-text
RAG_FORCE_LLM_FOR_KPI=true

# -------------------------------------------
# Backend
# -------------------------------------------
BACKEND_PORT=3000
BYPASS_AUTH=false
KEYCLOAK_CLIENT_SECRET=

# -------------------------------------------
# Frontend
# -------------------------------------------
FRONTEND_PORT=5173
VITE_BYPASS_KEYCLOAK=false

# -------------------------------------------
# Observability Stack
# -------------------------------------------
LOG_LEVEL=info
OTEL_ENABLED=true
METRICS_AUTH_TOKEN=change-me-metrics-token
VITE_OTEL_ENABLED=true
VITE_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
VITE_ENVIRONMENT=local

# Grafana
GRAFANA_ADMIN_USER=ims_admin
GRAFANA_ADMIN_PASSWORD=replace-with-strong-password
GRAFANA_PORT=3001

# Alertmanager SMTP (email alerts)
SMTP_SMARTHOST=smtp.gmail.com:587
SMTP_FROM=alerts@example.com
SMTP_AUTH_USERNAME=alerts@example.com
SMTP_AUTH_PASSWORD=replace-me
ALERT_EMAIL_TO=team@example.com
